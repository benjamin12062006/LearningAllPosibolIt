{
  "name": "estadistica-forms-api",
  "version": "0.3.0",
  "description": "API de formularios y estadísticas: aprendizaje incremental con NestJS.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/",
    "api:request": "httpyac requests/ --env local",
    "api:auth-test": "node scripts/descope/run-auth-request.mts",
    "prisma:generate": "prisma generate",
    "db:proxy": "node scripts/db/cloud-sql-proxy.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migration:create": "prisma migrate dev --create-only",
    "db:status": "prisma migrate status",
    "db:check": "pnpm build && node scripts/db/check-postgres.mjs",
    "db:smoke": "pnpm build && node scripts/db/smoke-postgres.mjs",
    "db:verify": "pnpm build && node --test test/prisma-migrations.test.mjs test/database-connection.test.mjs",
    "users:verify": "pnpm build && node --test test/users-*.test.mjs",
    "test:features:compile": "node scripts/testing/compile-features.mjs",
    "test:features": "pnpm test:features:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.features.config.mjs --runInBand",
    "test:features:unit": "pnpm test:features:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.features.config.mjs --runInBand --selectProjects unit",
    "test:features:integration": "pnpm test:features:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.features.config.mjs --runInBand --selectProjects integration",
    "test:features:e2e": "pnpm test:features:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.features.config.mjs --runInBand --selectProjects e2e",
    "test:features:cov": "pnpm test:features:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.features.config.mjs --runInBand --coverage",
    "test:features:watch": "pnpm test:features:compile && node scripts/testing/watch-features.mjs",
    "test:features:postgres": "node scripts/testing/postgres-features.mjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@descope/node-sdk": "^2.17.0",
    "@google-cloud/storage": "8.4.0",
    "@nestjs/apollo": "14.1.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.0.3",
    "@nestjs/graphql": "14.1.0",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "7.0.3",
    "graphql": "16.14.2",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "saxes": "6.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.0.3",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "httpyac": "^6.16.7",
    "jest": "30.5.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12"
  }
}
