generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["estadistica_forms"]
}

model AppUser {
  id              String    @id
  identityIssuer  String    @map("identity_issuer")
  identitySubject String    @map("identity_subject")
  email           String?
  displayName     String?   @map("display_name")
  createdAt       String    @map("created_at")
  updatedAt       String    @map("updated_at")
  projects        Project[]

  @@unique([identityIssuer, identitySubject])
  @@map("app_users")
  @@schema("estadistica_forms")
}

model Project {
  id             String            @id
  name           String
  ownerId        String            @map("owner_id")
  createdAt      String            @map("created_at")
  country        String?
  currency       String?
  channelProfile String?           @map("channel_profile")
  owner          AppUser           @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshots      CatalogSnapshot[]
  rulesets       RulesetVersion[]
  feed           Feed?

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_projects_owner_created")
  @@map("projects")
  @@schema("estadistica_forms")
}

/// Versión inmutable de mapeo y reglas de un proyecto. `mapping` y `rules` son
/// arreglos JSON: el orden de `rules` es el orden de aplicación.
model RulesetVersion {
  id          String       @id
  projectId   String       @map("project_id")
  revision    Int
  mapping     Json
  rules       Json
  createdAt   String       @map("created_at")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluations Evaluation[]

  @@unique([projectId, revision])
  @@unique([projectId, id])
  @@map("ruleset_versions")
  @@schema("estadistica_forms")
}

model CatalogSnapshot {
  id                   String             @id
  projectId            String             @map("project_id")
  idColumn             String             @map("id_column")
  delimiter            String
  headers              Json?
  sourceHash           String             @map("source_hash")
  artifactKey          String             @unique @map("artifact_key")
  byteSize             Int                @map("byte_size")
  originalName         String             @map("original_name")
  projectConfiguration Json               @map("project_configuration")
  status               String
  rowCount             Int?               @map("row_count")
  createdAt            String             @map("created_at")
  finishedAt           String?            @map("finished_at")
  error                Json?
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rows                 CatalogRow[]
  jobs                 CatalogImportJob[]
  evaluations          Evaluation[]

  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_catalog_snapshots_project_created")
  @@map("catalog_snapshots")
  @@schema("estadistica_forms")
}

model CatalogRow {
  snapshotId     String          @map("snapshot_id")
  sourceRow      Int             @map("source_row")
  externalId     String          @map("external_id")
  originalValues Json            @map("original_values")
  snapshot       CatalogSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([snapshotId, sourceRow])
  @@unique([snapshotId, externalId])
  @@map("catalog_rows")
  @@schema("estadistica_forms")
}

model CatalogImportJob {
  id             String          @id
  projectId      String          @map("project_id")
  snapshotId     String          @unique @map("snapshot_id")
  requestId      String          @map("request_id")
  status         String
  processedRows  Int             @default(0) @map("processed_rows")
  createdAt      String          @map("created_at")
  startedAt      String?         @map("started_at")
  finishedAt     String?         @map("finished_at")
  error          Json?
  /// Lease y token del proceso que lo lleva (plan jobs&files, D4). `runAfter`
  /// nulo es «listo ya»; solo un reintento lo rellena, con el reloj de la base.
  attempts       Int             @default(0)
  runAfter       DateTime?       @map("run_after") @db.Timestamptz(3)
  leaseUntil     DateTime?       @map("lease_until") @db.Timestamptz(3)
  executionToken String?         @map("execution_token")
  snapshot       CatalogSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, createdAt, id], map: "idx_catalog_jobs_queue")
  @@map("catalog_import_jobs")
  @@schema("estadistica_forms")
}

/// Evaluación de un snapshot con una versión de reglas; hace también de trabajo
/// (cola `queued → running → succeeded | failed`). Los conteos y la suma solo
/// existen cuando termina bien. La migración añade un índice único parcial que
/// Prisma no expresa: una sola evaluación activa por proyecto.
model Evaluation {
  id               String          @id
  projectId        String          @map("project_id")
  snapshotId       String          @map("snapshot_id")
  rulesetVersionId String          @map("ruleset_version_id")
  engineVersion    String          @map("engine_version")
  profileVersion   String          @map("profile_version")
  status           String
  totalCount       Int?            @map("total_count")
  validCount       Int?            @map("valid_count")
  invalidCount     Int?            @map("invalid_count")
  excludedCount    Int?            @map("excluded_count")
  resultChecksum   String?         @map("result_checksum")
  createdAt        String          @map("created_at")
  startedAt        String?         @map("started_at")
  finishedAt       String?         @map("finished_at")
  error            Json?
  /// Lease y token del proceso que la lleva (plan jobs&files, D7). `runAfter`
  /// nulo es «lista ya»; solo un reintento lo rellena, con el reloj de la base.
  attempts         Int             @default(0)
  runAfter         DateTime?       @map("run_after") @db.Timestamptz(3)
  leaseUntil       DateTime?       @map("lease_until") @db.Timestamptz(3)
  executionToken   String?         @map("execution_token")
  snapshot         CatalogSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  ruleset          RulesetVersion  @relation(fields: [projectId, rulesetVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  rows             EvaluationRow[]
  exports          Export[]
  feedVersions     FeedVersion[]

  @@unique([projectId, id])
  @@index([status, createdAt, id], map: "idx_evaluations_queue")
  @@map("evaluations")
  @@schema("estadistica_forms")
}

/// Resultado de una fila. `productValues` es nulo en las excluidas.
model EvaluationRow {
  evaluationId   String     @map("evaluation_id")
  sourceRow      Int        @map("source_row")
  externalId     String     @map("external_id")
  outcome        String
  productValues  Json?      @map("product_values")
  problems       Json
  excludedByRule Int?       @map("excluded_by_rule")
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([evaluationId, sourceRow])
  @@index([evaluationId, outcome, sourceRow], map: "idx_evaluation_rows_outcome")
  @@map("evaluation_rows")
  @@schema("estadistica_forms")
}

model Export {
  id                     String        @id
  projectId              String        @map("project_id")
  evaluationId           String        @unique @map("evaluation_id")
  approvedResultChecksum String        @map("approved_result_checksum")
  acceptedInvalidCount   Int           @map("accepted_invalid_count")
  acceptedExcludedCount  Int           @map("accepted_excluded_count")
  rowCount               Int           @map("row_count")
  artifactKey            String        @unique @map("artifact_key")
  byteSize               Int           @map("byte_size")
  tsvChecksum            String        @map("tsv_checksum")
  createdAt              String        @map("created_at")
  evaluation             Evaluation    @relation(fields: [projectId, evaluationId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  feedVersions           FeedVersion[]

  @@map("exports")
  @@schema("estadistica_forms")
}

/// Feed del proyecto (uno por proyecto en la fase B). `generation` cuenta las
/// publicaciones y es la versión que se compara al publicar (concurrencia
/// optimista); `published_version_id` apunta a una versión del mismo feed. Del
/// token de entrega solo se guarda su SHA-256; nulo = entrega desactivada. La
/// fuente remota (URL, columna id y separador) va completa o no va.
model Feed {
  id                    String        @id
  projectId             String        @unique @map("project_id")
  generation            Int           @default(0)
  publishedVersionId    String?       @map("published_version_id")
  deliveryTokenHash     String?       @unique @map("delivery_token_hash")
  sourceUrl             String?       @map("source_url")
  sourceIdColumn        String?       @map("source_id_column")
  sourceDelimiter       String?       @map("source_delimiter")
  policyRulesetRevision Int?          @map("policy_ruleset_revision")
  policyMaxInvalid      Int?          @map("policy_max_invalid")
  policyMaxExcluded     Int?          @map("policy_max_excluded")
  policyMaxDropPercent  Int?          @map("policy_max_drop_percent")
  policyEngineVersion   String?       @map("policy_engine_version")
  policyProfileVersion  String?       @map("policy_profile_version")
  policyApprovedAt      String?       @map("policy_approved_at")
  refreshEnabled        Boolean       @default(false) @map("refresh_enabled")
  refreshTime           String?       @map("refresh_time")
  timeZone              String?       @map("time_zone")
  createdAt             String        @map("created_at")
  updatedAt             String        @map("updated_at")
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  versions              FeedVersion[] @relation("FeedVersions")
  refreshes             FeedRefresh[]
  publishedVersion      FeedVersion?  @relation("PublishedVersion", fields: [id, publishedVersionId], references: [feedId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("feeds")
  @@schema("estadistica_forms")
}

/// Versión publicada de un feed, con su propio archivo (`feeds/<id>.tsv`,
/// enlace del TSV de la exportación). Evaluación y exportación son solo
/// trazabilidad: si se borran, la versión y su archivo siguen.
model FeedVersion {
  id              String      @id
  feedId          String      @map("feed_id")
  evaluationId    String?     @map("evaluation_id")
  exportId        String?     @map("export_id")
  artifactKey     String?     @unique @map("artifact_key")
  tsvChecksum     String      @map("tsv_checksum")
  byteSize        Int         @map("byte_size")
  rowCount        Int         @map("row_count")
  publishedBy     String      @map("published_by")
  createdAt       String      @map("created_at")
  feed            Feed        @relation("FeedVersions", fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluation      Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  export          Export?     @relation(fields: [exportId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  publishingFeeds Feed[]      @relation("PublishedVersion")

  @@unique([feedId, id])
  @@index([feedId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_feed_versions_feed_created")
  @@map("feed_versions")
  @@schema("estadistica_forms")
}

/// Actualización de un feed: un trabajo con lease y token de ejecución (plan
/// feeds&publications, D2–D4). Los ids de snapshot, importación y evaluación se
/// guardan antes de crearlos, por eso no son FK: al repetir un paso se ve si ya
/// existe. `run_after` y `lease_until` usan el reloj de la base y solo se
/// escriben con SQL: Prisma calcula `now()` en el cliente y lo envía sin zona
/// horaria, y la sesión lo desplaza (ver el repositorio).
model FeedRefresh {
  id                 String    @id
  feedId             String    @map("feed_id")
  status             String
  stage              String
  attempts           Int       @default(0)
  runAfter           DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz(3)
  executionToken     String?   @map("execution_token")
  snapshotId         String?   @map("snapshot_id")
  importJobId        String?   @map("import_job_id")
  evaluationId       String?   @map("evaluation_id")
  expectedGeneration Int?      @map("expected_generation")
  scheduledFor       String?   @map("scheduled_for")
  outcome            String?
  error              Json?
  createdAt          String    @map("created_at")
  finishedAt         String?   @map("finished_at")
  feed               Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([feedId, scheduledFor])
  @@index([status, runAfter, id], map: "idx_feed_refreshes_queue")
  @@index([feedId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_feed_refreshes_feed_created")
  @@map("feed_refreshes")
  @@schema("estadistica_forms")
}

/// Bandeja de salida (plan jobs&files, D8): efectos fuera de la base que se
/// guardan en la transacción que los provoca y ejecuta después el relay, con
/// lease y token. `done` es el recibo del manejador. Los `CHECK` de estado están
/// en la migración.
model OutboxEvent {
  id             String    @id
  type           String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  runAfter       DateTime? @map("run_after") @db.Timestamptz(3)
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  executionToken String?   @map("execution_token")
  error          Json?
  createdAt      String    @map("created_at")
  processedAt    String?   @map("processed_at")

  @@index([status, createdAt, id], map: "idx_outbox_events_ready")
  @@map("outbox_events")
  @@schema("estadistica_forms")
}
