generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["estadistica_forms"]
}

model AppUser {
  id                   String                       @id
  identityIssuer       String                       @map("identity_issuer")
  identitySubject      String                       @map("identity_subject")
  email                String?
  displayName          String?                      @map("display_name")
  createdAt            String                       @map("created_at")
  updatedAt            String                       @map("updated_at")
  projects             Project[]
  personalOrganization Organization?
  memberships          OrganizationMember[]
  sentInvitations      OrganizationInvitation[]     @relation("InvitedBy")
  acceptedInvitations  OrganizationInvitation[]     @relation("AcceptedBy")
  createdWorkbooks     Workbook[]
  createdWorksheets    Worksheet[]
  createdRevisions     WorksheetRevision[]
  authoredChangesets   WorksheetChangeset[]
  changesetDecisions   WorksheetChangesetDecision[]
  operationReceipts    OperationReceipt[]
  auditEvents          AuditEvent[]
  worksheetImports     WorksheetImport[]
  worksheetExports     WorksheetExport[]
  worksheetSnapshots   WorksheetSnapshot[]

  @@unique([identityIssuer, identitySubject])
  @@map("app_users")
  @@schema("estadistica_forms")
}

model Project {
  id             String            @id
  name           String
  ownerId        String            @map("owner_id")
  createdAt      String            @map("created_at")
  country        String?
  currency       String?
  channelProfile String?           @map("channel_profile")
  /// Obligatoria desde C6 (E1.2): el acceso se decide por la membresía en
  /// ella. `ownerId` queda como procedencia de quien lo creó.
  organizationId String            @map("organization_id")
  owner          AppUser           @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  snapshots      CatalogSnapshot[]
  rulesets       RulesetVersion[]
  feed           Feed?
  workbooks      Workbook[]

  @@unique([organizationId, id])
  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_projects_owner_created")
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_projects_organization_created")
  @@map("projects")
  @@schema("estadistica_forms")
}

/// Versión inmutable de mapeo y reglas de un proyecto. `mapping` y `rules` son
/// arreglos JSON: el orden de `rules` es el orden de aplicación.
model RulesetVersion {
  id          String       @id
  projectId   String       @map("project_id")
  revision    Int
  mapping     Json
  rules       Json
  createdAt   String       @map("created_at")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluations Evaluation[]

  @@unique([projectId, revision])
  @@unique([projectId, id])
  @@map("ruleset_versions")
  @@schema("estadistica_forms")
}

model CatalogSnapshot {
  id                   String             @id
  projectId            String             @map("project_id")
  idColumn             String             @map("id_column")
  delimiter            String
  headers              Json?
  sourceHash           String             @map("source_hash")
  artifactKey          String             @unique @map("artifact_key")
  byteSize             Int                @map("byte_size")
  originalName         String             @map("original_name")
  projectConfiguration Json               @map("project_configuration")
  status               String
  rowCount             Int?               @map("row_count")
  createdAt            String             @map("created_at")
  finishedAt           String?            @map("finished_at")
  error                Json?
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rows                 CatalogRow[]
  jobs                 CatalogImportJob[]
  evaluations          Evaluation[]
  worksheetSource      WorksheetSnapshot?

  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_catalog_snapshots_project_created")
  @@map("catalog_snapshots")
  @@schema("estadistica_forms")
}

model CatalogRow {
  snapshotId     String          @map("snapshot_id")
  sourceRow      Int             @map("source_row")
  externalId     String          @map("external_id")
  originalValues Json            @map("original_values")
  snapshot       CatalogSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([snapshotId, sourceRow])
  @@unique([snapshotId, externalId])
  @@map("catalog_rows")
  @@schema("estadistica_forms")
}

model CatalogImportJob {
  id             String          @id
  projectId      String          @map("project_id")
  snapshotId     String          @unique @map("snapshot_id")
  requestId      String          @map("request_id")
  status         String
  processedRows  Int             @default(0) @map("processed_rows")
  createdAt      String          @map("created_at")
  startedAt      String?         @map("started_at")
  finishedAt     String?         @map("finished_at")
  error          Json?
  /// Lease y token del proceso que lo lleva (plan jobs&files, D4). `runAfter`
  /// nulo es «listo ya»; solo un reintento lo rellena, con el reloj de la base.
  attempts       Int             @default(0)
  runAfter       DateTime?       @map("run_after") @db.Timestamptz(3)
  leaseUntil     DateTime?       @map("lease_until") @db.Timestamptz(3)
  executionToken String?         @map("execution_token")
  snapshot       CatalogSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, createdAt, id], map: "idx_catalog_jobs_queue")
  @@map("catalog_import_jobs")
  @@schema("estadistica_forms")
}

/// Evaluación de un snapshot con una versión de reglas; hace también de trabajo
/// (cola `queued → running → succeeded | failed`). Los conteos y la suma solo
/// existen cuando termina bien. La migración añade un índice único parcial que
/// Prisma no expresa: una sola evaluación activa por proyecto.
model Evaluation {
  id               String          @id
  projectId        String          @map("project_id")
  snapshotId       String          @map("snapshot_id")
  rulesetVersionId String          @map("ruleset_version_id")
  engineVersion    String          @map("engine_version")
  profileVersion   String          @map("profile_version")
  status           String
  totalCount       Int?            @map("total_count")
  validCount       Int?            @map("valid_count")
  invalidCount     Int?            @map("invalid_count")
  excludedCount    Int?            @map("excluded_count")
  resultChecksum   String?         @map("result_checksum")
  createdAt        String          @map("created_at")
  startedAt        String?         @map("started_at")
  finishedAt       String?         @map("finished_at")
  error            Json?
  /// Lease y token del proceso que la lleva (plan jobs&files, D7). `runAfter`
  /// nulo es «lista ya»; solo un reintento lo rellena, con el reloj de la base.
  attempts         Int             @default(0)
  runAfter         DateTime?       @map("run_after") @db.Timestamptz(3)
  leaseUntil       DateTime?       @map("lease_until") @db.Timestamptz(3)
  executionToken   String?         @map("execution_token")
  snapshot         CatalogSnapshot @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  ruleset          RulesetVersion  @relation(fields: [projectId, rulesetVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  rows             EvaluationRow[]
  exports          Export[]
  feedVersions     FeedVersion[]

  @@unique([projectId, id])
  @@index([status, createdAt, id], map: "idx_evaluations_queue")
  @@map("evaluations")
  @@schema("estadistica_forms")
}

/// Resultado de una fila. `productValues` es nulo en las excluidas.
model EvaluationRow {
  evaluationId   String     @map("evaluation_id")
  sourceRow      Int        @map("source_row")
  externalId     String     @map("external_id")
  outcome        String
  productValues  Json?      @map("product_values")
  problems       Json
  excludedByRule Int?       @map("excluded_by_rule")
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([evaluationId, sourceRow])
  @@index([evaluationId, outcome, sourceRow], map: "idx_evaluation_rows_outcome")
  @@map("evaluation_rows")
  @@schema("estadistica_forms")
}

model Export {
  id                     String        @id
  projectId              String        @map("project_id")
  evaluationId           String        @unique @map("evaluation_id")
  approvedResultChecksum String        @map("approved_result_checksum")
  acceptedInvalidCount   Int           @map("accepted_invalid_count")
  acceptedExcludedCount  Int           @map("accepted_excluded_count")
  rowCount               Int           @map("row_count")
  artifactKey            String        @unique @map("artifact_key")
  byteSize               Int           @map("byte_size")
  tsvChecksum            String        @map("tsv_checksum")
  createdAt              String        @map("created_at")
  evaluation             Evaluation    @relation(fields: [projectId, evaluationId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  feedVersions           FeedVersion[]

  @@map("exports")
  @@schema("estadistica_forms")
}

/// Feed del proyecto (uno por proyecto en la fase B). `generation` cuenta las
/// publicaciones y es la versión que se compara al publicar (concurrencia
/// optimista); `published_version_id` apunta a una versión del mismo feed. Del
/// token de entrega solo se guarda su SHA-256; nulo = entrega desactivada. La
/// fuente remota (URL, columna id y separador) va completa o no va.
model Feed {
  id                    String        @id
  projectId             String        @unique @map("project_id")
  generation            Int           @default(0)
  publishedVersionId    String?       @map("published_version_id")
  deliveryTokenHash     String?       @unique @map("delivery_token_hash")
  sourceUrl             String?       @map("source_url")
  sourceIdColumn        String?       @map("source_id_column")
  sourceDelimiter       String?       @map("source_delimiter")
  policyRulesetRevision Int?          @map("policy_ruleset_revision")
  policyMaxInvalid      Int?          @map("policy_max_invalid")
  policyMaxExcluded     Int?          @map("policy_max_excluded")
  policyMaxDropPercent  Int?          @map("policy_max_drop_percent")
  policyEngineVersion   String?       @map("policy_engine_version")
  policyProfileVersion  String?       @map("policy_profile_version")
  policyApprovedAt      String?       @map("policy_approved_at")
  refreshEnabled        Boolean       @default(false) @map("refresh_enabled")
  refreshTime           String?       @map("refresh_time")
  timeZone              String?       @map("time_zone")
  createdAt             String        @map("created_at")
  updatedAt             String        @map("updated_at")
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  versions              FeedVersion[] @relation("FeedVersions")
  refreshes             FeedRefresh[]
  publishedVersion      FeedVersion?  @relation("PublishedVersion", fields: [id, publishedVersionId], references: [feedId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("feeds")
  @@schema("estadistica_forms")
}

/// Versión publicada de un feed, con su propio archivo (`feeds/<id>.tsv`,
/// enlace del TSV de la exportación). Evaluación y exportación son solo
/// trazabilidad: si se borran, la versión y su archivo siguen.
model FeedVersion {
  id              String      @id
  feedId          String      @map("feed_id")
  evaluationId    String?     @map("evaluation_id")
  exportId        String?     @map("export_id")
  artifactKey     String?     @unique @map("artifact_key")
  tsvChecksum     String      @map("tsv_checksum")
  byteSize        Int         @map("byte_size")
  rowCount        Int         @map("row_count")
  publishedBy     String      @map("published_by")
  createdAt       String      @map("created_at")
  feed            Feed        @relation("FeedVersions", fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluation      Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  export          Export?     @relation(fields: [exportId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  publishingFeeds Feed[]      @relation("PublishedVersion")

  @@unique([feedId, id])
  @@index([feedId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_feed_versions_feed_created")
  @@map("feed_versions")
  @@schema("estadistica_forms")
}

/// Empresa dueña de proyectos (ampliación E1). `personalOwnerId` marca la
/// organización personal de un usuario: como mucho una por usuario, lo que hace
/// repetible el backfill de los propietarios heredados.
model Organization {
  id                String                   @id
  name              String
  personalOwnerId   String?                  @unique @map("personal_owner_id")
  createdAt         String                   @map("created_at")
  /// Nula = activa (E1.4). Una organización personal nunca se archiva.
  archivedAt        String?                  @map("archived_at")
  personalOwner     AppUser?                 @relation(fields: [personalOwnerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  projects          Project[]
  operationReceipts OperationReceipt[]
  auditEvents       AuditEvent[]

  @@map("organizations")
  @@schema("estadistica_forms")
}

/// Rol de una persona en una organización. La migración limita `role` a
/// owner, admin, manager, editor y viewer.
model OrganizationMember {
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String
  createdAt      String       @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, userId])
  @@index([userId, organizationId], map: "idx_organization_members_user")
  @@map("organization_members")
  @@schema("estadistica_forms")
}

/// Actualización de un feed: un trabajo con lease y token de ejecución (plan
/// feeds&publications, D2–D4). Los ids de snapshot, importación y evaluación se
/// guardan antes de crearlos, por eso no son FK: al repetir un paso se ve si ya
/// existe. `run_after` y `lease_until` usan el reloj de la base y solo se
/// escriben con SQL: Prisma calcula `now()` en el cliente y lo envía sin zona
/// horaria, y la sesión lo desplaza (ver el repositorio).
model FeedRefresh {
  id                 String    @id
  feedId             String    @map("feed_id")
  status             String
  stage              String
  attempts           Int       @default(0)
  runAfter           DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz(3)
  executionToken     String?   @map("execution_token")
  snapshotId         String?   @map("snapshot_id")
  importJobId        String?   @map("import_job_id")
  evaluationId       String?   @map("evaluation_id")
  expectedGeneration Int?      @map("expected_generation")
  scheduledFor       String?   @map("scheduled_for")
  outcome            String?
  error              Json?
  createdAt          String    @map("created_at")
  finishedAt         String?   @map("finished_at")
  feed               Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([feedId, scheduledFor])
  @@index([status, runAfter, id], map: "idx_feed_refreshes_queue")
  @@index([feedId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_feed_refreshes_feed_created")
  @@map("feed_refreshes")
  @@schema("estadistica_forms")
}

/// Invitación a una organización (E1.3). Del token solo se guarda su SHA-256.
/// La migración añade un índice único parcial que Prisma no expresa: como mucho
/// una invitación pendiente (sin aceptar ni revocar) por organización y correo.
model OrganizationInvitation {
  id              String       @id
  organizationId  String       @map("organization_id")
  emailNormalized String       @map("email_normalized")
  role            String
  tokenHash       String       @unique @map("token_hash")
  invitedBy       String       @map("invited_by")
  createdAt       String       @map("created_at")
  expiresAt       String       @map("expires_at")
  acceptedAt      String?      @map("accepted_at")
  acceptedBy      String?      @map("accepted_by")
  revokedAt       String?      @map("revoked_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter         AppUser      @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptor        AppUser?     @relation("AcceptedBy", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_organization_invitations_organization_created")
  @@map("organization_invitations")
  @@schema("estadistica_forms")
}

/// Libro de un proyecto (ampliación E3.1). Agrupa hojas. La FK compuesta
/// `(organizationId, projectId)` impide colocarlo en otra organización.
model Workbook {
  id             String      @id
  organizationId String      @map("organization_id")
  projectId      String      @map("project_id")
  name           String
  nameNormalized String      @map("name_normalized")
  createdBy      String      @map("created_by")
  createdAt      String      @map("created_at")
  project        Project     @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  creator        AppUser     @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  worksheets     Worksheet[]

  @@unique([projectId, nameNormalized])
  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_workbooks_project_created")
  @@map("workbooks")
  @@schema("estadistica_forms")
}

/// Hoja libre (E3.1). `headRevisionId` apunta a una revisión de la propia hoja;
/// solo es nulo dentro de la transacción que la crea. `generation` cuenta las
/// revisiones.
model Worksheet {
  id             String                   @id
  organizationId String                   @map("organization_id")
  projectId      String                   @map("project_id")
  workbookId     String                   @map("workbook_id")
  name           String
  nameNormalized String                   @map("name_normalized")
  mode           String
  schemaVersion  Int                      @map("schema_version")
  generation     Int
  headRevisionId String?                  @map("head_revision_id")
  createdBy      String                   @map("created_by")
  createdAt      String                   @map("created_at")
  workbook       Workbook                 @relation(fields: [organizationId, projectId, workbookId], references: [organizationId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  headRevision   WorksheetRevision?       @relation("WorksheetHead", fields: [id, headRevisionId], references: [worksheetId, id], onDelete: NoAction, onUpdate: NoAction)
  creator        AppUser                  @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  columns        WorksheetColumnVersion[]
  revisions      WorksheetRevision[]      @relation("WorksheetRevisions")
  rowVersions    WorksheetRowVersion[]
  changesets     WorksheetChangeset[]
  exports        WorksheetExport[]
  snapshots      WorksheetSnapshot[]

  @@unique([workbookId, nameNormalized])
  @@unique([organizationId, id])
  @@index([organizationId, workbookId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_worksheets_workbook_created")
  @@map("worksheets")
  @@schema("estadistica_forms")
}

/// Columna de una hoja en una versión de esquema. `columnId` no cambia al
/// renombrar ni al mover la columna.
model WorksheetColumnVersion {
  organizationId String    @map("organization_id")
  worksheetId    String    @map("worksheet_id")
  schemaVersion  Int       @map("schema_version")
  columnId       String    @map("column_id")
  name           String
  nameNormalized String    @map("name_normalized")
  type           String
  position       Int
  required       Boolean
  /// Solo en selección: `[{ id, label }]`.
  options        Json?
  /// Solo en calculada: `{ engine, expression, scale, rounding }`.
  formula        Json?
  worksheet      Worksheet @relation(fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([worksheetId, schemaVersion, columnId])
  @@unique([worksheetId, schemaVersion, nameNormalized])
  @@unique([worksheetId, schemaVersion, position])
  @@map("worksheet_column_versions")
  @@schema("estadistica_forms")
}

/// Revisión inmutable de una hoja, numerada desde 1.
model WorksheetRevision {
  id             String                @id
  organizationId String                @map("organization_id")
  worksheetId    String                @map("worksheet_id")
  sequence       Int
  schemaVersion  Int                   @map("schema_version")
  source         String
  rowCount       Int                   @map("row_count")
  createdBy      String                @map("created_by")
  createdAt      String                @map("created_at")
  /// Borrador que la produjo; nulo en la revisión `initialize`.
  changesetId    String?               @unique @map("changeset_id")
  worksheet      Worksheet             @relation("WorksheetRevisions", fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  creator        AppUser               @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  headOf         Worksheet[]           @relation("WorksheetHead")
  openedRows     WorksheetRowVersion[] @relation("RowFrom")
  closedRows     WorksheetRowVersion[] @relation("RowTo")
  changeset      WorksheetChangeset?   @relation("ChangesetRevision", fields: [organizationId, changesetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  baseOf         WorksheetChangeset[]  @relation("ChangesetBase")
  exports        WorksheetExport[]
  snapshots      WorksheetSnapshot[]

  @@unique([worksheetId, sequence])
  @@unique([worksheetId, id])
  @@map("worksheet_revisions")
  @@schema("estadistica_forms")
}

/// Versión de una fila válida en las revisiones [fromSequence, toSequence)
/// (E3.2). `toSequence` nulo = vigente; la migración añade un índice único
/// parcial que Prisma no expresa: una sola versión vigente por fila.
model WorksheetRowVersion {
  organizationId String             @map("organization_id")
  worksheetId    String             @map("worksheet_id")
  rowId          String             @map("row_id")
  fromSequence   Int                @map("from_sequence")
  toSequence     Int?               @map("to_sequence")
  sortKey        String             @map("sort_key")
  cellValues     Json               @map("cell_values")
  isDeleted      Boolean            @default(false) @map("is_deleted")
  worksheet      Worksheet          @relation(fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  fromRevision   WorksheetRevision  @relation("RowFrom", fields: [worksheetId, fromSequence], references: [worksheetId, sequence], onDelete: Restrict, onUpdate: NoAction)
  toRevision     WorksheetRevision? @relation("RowTo", fields: [worksheetId, toSequence], references: [worksheetId, sequence], onDelete: Restrict, onUpdate: NoAction)

  @@id([worksheetId, rowId, fromSequence])
  @@index([worksheetId, fromSequence, sortKey, rowId], map: "idx_worksheet_row_versions_revision")
  @@map("worksheet_row_versions")
  @@schema("estadistica_forms")
}

/// Borrador de cambios sobre una hoja (E4). `operations` es la lista
/// normalizada; `draftVersion` es su ETag; `contentHash` existe desde el envío.
model WorksheetChangeset {
  id                String                       @id
  organizationId    String                       @map("organization_id")
  projectId         String                       @map("project_id")
  worksheetId       String                       @map("worksheet_id")
  authorId          String                       @map("author_id")
  source            String
  title             String
  status            String
  draftVersion      Int                          @map("draft_version")
  baseRevisionId    String                       @map("base_revision_id")
  baseSequence      Int                          @map("base_sequence")
  baseSchemaVersion Int                          @map("base_schema_version")
  operations        Json
  contentHash       String?                      @map("content_hash")
  appliedRevisionId String?                      @map("applied_revision_id")
  createdAt         String                       @map("created_at")
  updatedAt         String                       @map("updated_at")
  worksheet         Worksheet                    @relation(fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  baseRevision      WorksheetRevision            @relation("ChangesetBase", fields: [worksheetId, baseRevisionId], references: [worksheetId, id], onDelete: Restrict, onUpdate: NoAction)
  author            AppUser                      @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decisions         WorksheetChangesetDecision[]
  /// Como mucho una: lo garantiza el índice único de `changeset_id`.
  revisions         WorksheetRevision[]          @relation("ChangesetRevision")
  /// Como mucho una: la importación que creó este borrador (E5.1).
  imports           WorksheetImport[]

  @@unique([organizationId, id])
  @@index([organizationId, worksheetId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_worksheet_changesets_worksheet_created")
  @@map("worksheet_changesets")
  @@schema("estadistica_forms")
}

/// Decisión de revisión (solo se añaden filas). `policy` dice por qué se
/// permitió: otra persona (`peer`) o empresa de un solo miembro.
model WorksheetChangesetDecision {
  id             String             @id
  organizationId String             @map("organization_id")
  changesetId    String             @map("changeset_id")
  actorId        String             @map("actor_id")
  decision       String
  contentHash    String             @map("content_hash")
  draftVersion   Int                @map("draft_version")
  headRevisionId String             @map("head_revision_id")
  policy         String
  reason         String?
  createdAt      String             @map("created_at")
  changeset      WorksheetChangeset @relation(fields: [organizationId, changesetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  actor          AppUser            @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([changesetId, createdAt], map: "idx_worksheet_changeset_decisions_changeset")
  @@map("worksheet_changeset_decisions")
  @@schema("estadistica_forms")
}

/// Recibo de una operación idempotente (parte de E2): misma clave y mismo
/// cuerpo devuelven `result` sin repetir el efecto.
model OperationReceipt {
  organizationId String       @map("organization_id")
  actorId        String       @map("actor_id")
  operation      String
  resourceId     String       @map("resource_id")
  idempotencyKey String       @map("idempotency_key")
  payloadHash    String       @map("payload_hash")
  result         Json
  createdAt      String       @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor          AppUser      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, actorId, operation, resourceId, idempotencyKey])
  @@map("operation_receipts")
  @@schema("estadistica_forms")
}

/// Evento de auditoría (solo se añaden filas).
model AuditEvent {
  id             String       @id
  organizationId String       @map("organization_id")
  actorId        String       @map("actor_id")
  action         String
  resourceType   String       @map("resource_type")
  resourceId     String       @map("resource_id")
  details        Json
  createdAt      String       @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor          AppUser      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, resourceType, resourceId, createdAt], map: "idx_audit_events_resource")
  @@map("audit_events")
  @@schema("estadistica_forms")
}

/// Bandeja de salida (plan jobs&files, D8): efectos fuera de la base que se
/// guardan en la transacción que los provoca y ejecuta después el relay, con
/// lease y token. `done` es el recibo del manejador. Los `CHECK` de estado están
/// en la migración.
model OutboxEvent {
  id             String    @id
  type           String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  runAfter       DateTime? @map("run_after") @db.Timestamptz(3)
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  executionToken String?   @map("execution_token")
  error          Json?
  createdAt      String    @map("created_at")
  processedAt    String?   @map("processed_at")

  @@index([status, createdAt, id], map: "idx_outbox_events_ready")
  @@map("outbox_events")
  @@schema("estadistica_forms")
}

/// Importación de un CSV a un borrador de hoja (E5.1). El original no se
/// guarda: su hash, sus opciones y el informe son la procedencia.
model WorksheetImport {
  id             String             @id
  organizationId String             @map("organization_id")
  projectId      String             @map("project_id")
  worksheetId    String             @map("worksheet_id")
  changesetId    String             @unique @map("changeset_id")
  createdBy      String             @map("created_by")
  format         String
  fileHash       String             @map("file_hash")
  fileBytes      Int                @map("file_bytes")
  options        Json
  report         Json
  excludedRows   Json               @map("excluded_rows")
  includedHash   String             @map("included_hash")
  createdAt      String             @map("created_at")
  changeset      WorksheetChangeset @relation(fields: [organizationId, changesetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  creator        AppUser            @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, worksheetId, createdAt(sort: Desc)], map: "idx_worksheet_imports_worksheet_created")
  @@map("worksheet_imports")
  @@schema("estadistica_forms")
}

/// Exportación de una revisión fija de hoja a CSV o XLSX (E5.3). El archivo se
/// guarda en `worksheet-exports/` y solo se referencia después de releerlo y
/// comprobar su SHA-256.
model WorksheetExport {
  id                String            @id
  organizationId    String            @map("organization_id")
  projectId         String            @map("project_id")
  worksheetId       String            @map("worksheet_id")
  revisionId        String            @map("revision_id")
  revisionSequence  Int               @map("revision_sequence")
  createdBy         String            @map("created_by")
  format            String
  /// Solo CSV: separador y política de fórmulas.
  options           Json
  /// Columnas resueltas, filtro y orden tal como se validaron.
  query             Json
  serializerVersion String            @map("serializer_version")
  rowCount          Int               @map("row_count")
  columnCount       Int               @map("column_count")
  problemCellCount  Int               @map("problem_cell_count")
  byteSize          Int               @map("byte_size")
  checksum          String
  artifactKey       String            @unique @map("artifact_key")
  createdAt         String            @map("created_at")
  worksheet         Worksheet         @relation(fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  revision          WorksheetRevision @relation(fields: [worksheetId, revisionId], references: [worksheetId, id], onDelete: Restrict, onUpdate: NoAction)
  creator           AppUser           @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, worksheetId, createdAt(sort: Desc)], map: "idx_worksheet_exports_worksheet_created")
  @@map("worksheet_exports")
  @@schema("estadistica_forms")
}

/// Procedencia de un snapshot de catálogo creado desde una revisión de hoja
/// (E5.4, plan imports&exports 01, D22–D28): qué hoja, revisión y columnas lo
/// formaron. Se borra con su snapshot; la revisión, nunca.
model WorksheetSnapshot {
  snapshotId        String            @id @map("snapshot_id")
  projectId         String            @map("project_id")
  organizationId    String            @map("organization_id")
  worksheetId       String            @map("worksheet_id")
  revisionId        String            @map("revision_id")
  revisionSequence  Int               @map("revision_sequence")
  createdBy         String            @map("created_by")
  idColumnId        String            @map("id_column_id")
  /// Columnas elegidas con la cabecera que tienen en el snapshot.
  columns           Json
  /// Filtro y orden tal como se validaron.
  query             Json
  serializerVersion String            @map("serializer_version")
  rowCount          Int               @map("row_count")
  sourceHash        String            @map("source_hash")
  createdAt         String            @map("created_at")
  snapshot          CatalogSnapshot   @relation(fields: [projectId, snapshotId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  worksheet         Worksheet         @relation(fields: [organizationId, worksheetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  revision          WorksheetRevision @relation(fields: [worksheetId, revisionId], references: [worksheetId, id], onDelete: Restrict, onUpdate: NoAction)
  creator           AppUser           @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projectId, snapshotId])
  @@index([organizationId, worksheetId, createdAt(sort: Desc)], map: "idx_worksheet_catalog_snapshots_worksheet_created")
  @@map("worksheet_catalog_snapshots")
  @@schema("estadistica_forms")
}
