# Descope Project ID usado también como audiencia predeterminada del session JWT.
DESCOPE_PROJECT_ID=your-descope-project-id

# Solo para el script local de pruebas E2E. Nunca se exponen al frontend.
DESCOPE_MANAGEMENT_KEY=your-descope-management-key
DESCOPE_TEST_LOGIN_ID=auth-test@example.test

# PostgreSQL de Neon. Solo servidor: nunca lo expongas al frontend ni lo subas a Git.
# Usa la cadena con pooler (host -pooler); Prisma CLI deriva la conexión directa.
DATABASE_URL='postgresql://usuario:contraseña@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require'

# Volumen privado persistente de CatalogImport (una instancia API/worker).
# Valor vacío usa .data/catalog-import; no apuntar a public/ ni montar como estático.
CATALOG_IMPORT_ROOT=
