# Descope Project ID usado también como audiencia predeterminada del session JWT.
DESCOPE_PROJECT_ID=your-descope-project-id

# Solo para el script local de pruebas E2E. Nunca se exponen al frontend.
DESCOPE_MANAGEMENT_KEY=your-descope-management-key
DESCOPE_TEST_LOGIN_ID=auth-test@example.test

# Cloud SQL para PostgreSQL (plan google-cloud/db 01). La API y Prisma entran por
# Cloud SQL Auth Proxy en 127.0.0.1:5433 (`pnpm db:proxy`) con la cuenta de Google
# (IAM), sin contraseña: el usuario es el correo de la cuenta, con @ codificado.
CLOUD_SQL_INSTANCE=proyecto:region:instancia
DATABASE_URL='postgresql://tu-correo%40gmail.com@127.0.0.1:5433/estadistica_forms'

# Volumen privado persistente de CatalogImport (una instancia API/worker).
# Valor vacío usa .data/catalog-import; no apuntar a public/ ni montar como estático.
CATALOG_IMPORT_ROOT=

# Servicio de IA interno (plan E6, E6.1b). Sin AI_SERVICE_URL el asistente está
# desactivado. El token es el mismo AI_SERVICE_TOKEN del .env del servicio de IA
# (32+ caracteres; `make token` allí).
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Usa false para probar el asistente sin sincronizar documentos con el índice.
AI_KNOWLEDGE_SYNC_ENABLED=true

# Servidor MCP para clientes externos (plan 07, E6.7). Es el secreto con el que
# el servidor MCP del servicio de IA se identifica ante esta API; allí se llama
# KTSU_MCP_ADAPTER_TOKEN. Sin él, las integraciones externas responden 503.
MCP_ADAPTER_SERVICE_TOKEN=

# MCP remoto: URL pública exacta, issuer de Discovery en Descope y ámbito KTSU.
MCP_OAUTH_RESOURCE_URL=
MCP_OAUTH_ISSUER=
MCP_OAUTH_ORGANIZATION_ID=
MCP_OAUTH_PROJECT_ID=

# CLI OAuth: Inbound App público de Descope y API Resource dedicado.
# Deja las tres variables vacías para ofrecer solo credenciales de proyecto.
CLI_OAUTH_CLIENT_ID=
CLI_OAUTH_ISSUER=
CLI_OAUTH_RESOURCE_URL=
