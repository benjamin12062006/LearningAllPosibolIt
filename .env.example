# Descope Project ID usado también como audiencia predeterminada del session JWT.
DESCOPE_PROJECT_ID=your-descope-project-id

# Solo para el script local de pruebas E2E. Nunca se exponen al frontend.
DESCOPE_MANAGEMENT_KEY=your-descope-management-key
DESCOPE_TEST_LOGIN_ID=auth-test@example.test

# Conexión del runtime Nest por Cloud SQL Connector + ADC (sin proxy).
GOOGLE_CLOUD_QUOTA_PROJECT=expo-city-bol
INSTANCE_CONNECTION_NAME=expo-city-bol:us-east4:expo-city-bol-instance
DB_NAME=expo-city-bol-database
DB_USER=catalogo_api
# Conserva literalmente la contraseña del usuario PostgreSQL, entre comillas.
DB_PASSWORD='your-postgresql-password'

# Solo Prisma CLI: requiere un Auth Proxy en 127.0.0.1:5433.
# Puede usar un propietario SQL distinto al usuario del runtime.
# Codifica usuario/contraseña como componentes URL (por ejemplo, @ -> %40).
POSTGRES_MIGRATION_DATABASE_URL='postgresql://migration-owner:encoded-password@127.0.0.1:5433/expo-city-bol-database?schema=estadistica_forms&sslmode=disable'

# Volumen privado persistente de CatalogImport (una instancia API/worker).
# Valor vacío usa .data/catalog-import; no apuntar a public/ ni montar como estático.
CATALOG_IMPORT_ROOT=
